# Required — used to filter/summarize papers and generate action items.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you want the digest emailed to you.
# For Gmail: create an "app password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_TO=you@gmail.com

# Optional — only needed to enable the Google Scholar source via SerpApi
# (https://serpapi.com). Without this, Google Scholar is skipped silently.
SERPAPI_API_KEY=

# Optional overrides
DAYS_BACK=2
CLAUDE_MODEL=claude-sonnet-4-6
